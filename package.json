{
  "name": "zolt",
  "version": "1.0.0",
  "description": "",
  "main": "src/app/server.js",
  "scripts": {
    "lint": "eslint src/** /*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "dev": "nodemon --exec tsx src/app/server.ts",
    "build": "tsc",
    "start": "dist/app/server.js",
    "tests": "vitest run",
    "db:create-migration": "node-pg-migrate create",
    "db:migrate": "tsx ./node_modules/node-pg-migrate/bin/node-pg-migrate.js up",
    "db:migrate:down": "tsx ./node_modules/node-pg-migrate/bin/node-pg-migrate.js down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "bullmq": "^6.3.6",
    "dotenv": "^17.4.2",
    "ioredis": "^6.0.0",
    "node-pg-migrate": "^9.0.0",
    "nodemon": "^3.1.14",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  }
}
